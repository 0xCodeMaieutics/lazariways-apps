{
    "name": "Personalgeorgien",
    "description": "Base Level Extension",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_icon": {
            "16": "extension_logo.png",
            "32": "extension_logo.png"
        }
    },
    "side_panel": {
        "default_path": "index.html",
        "default_icon": "extension_logo.png"
    },
    "permissions": [
        "storage",
        "scripting",
        "activeTab",
        "sidePanel"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ]
}