      "options": ["მადლობა", "გთხოვთ", "ბოდიში"],
      "correctOptionIndex": 0
    },
    {
      "type": "CHOOSE_FROM_TEXT",
      "prompt": "რას ნიშნავს?",
      "text": "Ich verstehe nicht.",
      "options": ["არ მესმის.", "არ ვიცი.", "არ მინდა."],
      "correctOptionIndex": 0
    },
    {
      "type": "CHOOSE_FROM_AUDIO",
      "prompt": "რა გესმის?",
