    },
    {
      "type": "INPUT_FROM_AUDIO",
      "prompt": "დაწერე, რაც გესმის",
      "audioText": "Können Sie das wiederholen?",
      "correctInputs": ["Können Sie das wiederholen?"]
    },
    {
      "type": "INPUT_SENTENCE_FROM_TEXT",
      "prompt": "თარგმნე გერმანულად",
      "text": "არ მესმის.",
      "correctInputs": ["Ich verstehe nicht.", "Ich verstehe das nicht."]
    },
    {
      "type": "INPUT_SENTENCE_FROM_TEXT",
      "prompt": "თარგმნე გერმანულად",
      "text": "უფრო ნელა, გთხოვთ.",
      "correctInputs": ["Langsamer, bitte.", "Bitte langsamer.", "Etwas langsamer, bitte."]
    }
  ]
}
