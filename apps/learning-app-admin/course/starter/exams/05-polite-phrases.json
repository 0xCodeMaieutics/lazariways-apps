    },
    {
      "type": "CHOOSE_MATCHING_PATTERNS",
      "prompt": "დანიშნე შესატყვისი წყვილები",
      "matchingPairs": [
        { "term": "bitte", "meaning": "გთხოვთ" },
        { "term": "ja", "meaning": "კი" },
        { "term": "nein", "meaning": "არა" },
        { "term": "Danke schön", "meaning": "დიდი მადლობა" }
      ]
    },
    {
      "type": "INPUT_FROM_TEXT",
      "prompt": "დაწერე გერმანულად",
      "text": "მადლობა",
      "correctInputs": ["Danke"]
    },
    {
      "type": "INPUT_FROM_TEXT",
      "prompt": "დაწერე გერმანულად",
      "text": "ბოდიში",
