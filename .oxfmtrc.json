{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "semi": false,
  "trailingComma": "es5",
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": {
    "stylesheet": "./packages/ui/src/styles/globals.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "**/next-env.d.ts",
    "packages/database/prisma/migrations/**",
    "packages/email/templates/**"
  ]
}
