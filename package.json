{
  "name": "lazari-ways-apps-new",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "turbo typecheck",
    "prisma": "dotenvx run -f packages/database/.env -- pnpm --filter=@lazariways/database exec prisma",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check",
    "turbo-env:check": "node scripts/check-turbo-env.mts"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.61.0",
    "@lazariways/typescript-config": "workspace:*",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "turbo": "^2.9.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4"
}
