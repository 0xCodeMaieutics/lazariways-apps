enum UserRole {
  ADMIN
  USER

  @@schema("lazari_lingo")
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  role          UserRole @default(USER)
  image         String?

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  sessions             Session[]
  accounts             Account[]
  userExamAggregations UserExamAggregation[]
  userExamCompletions  UserExam[]
  userUnlockedExams    UserUnlockedExam[]

  @@schema("lazari_lingo")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@schema("lazari_lingo")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@schema("lazari_lingo")
}

enum TopicType {
  STARTER
  BAECKEREI
  FREIZEIT_PARK

  @@schema("lazari_lingo")
}

model Topic {
  id String @id @default(nanoid())

  createdAt DateTime @default(now())

  name    String
  type    TopicType
  enabled Boolean
  order   Int

  exams Exam[]

  @@schema("lazari_lingo")
}

model Exam {
  id          String     @id @default(nanoid())
  title       String
  description String
  enable      Boolean    @default(false)
  exercises   Exercise[]

  order                         Int
  estimatedTimeInMinutes        Int?
  minimumCorrectAnswerCount     Int  @default(1) // correctAnswers >= this to pass
  minimumPassedCount            Int  @default(1) // minimum passed count to consider the practice to be passed
  waitUntilPassAllowedInSeconds Int  @default(14400) // cooldown in seconds between counted passes (4 hours)

  userExamAggregation UserExamAggregation[]
  userExamCompletions UserExam[]
  userUnlockedExams   UserUnlockedExam[]

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id])

  unlockedId   String?
  unlockedExam Exam?   @relation("UnlocksExams", fields: [unlockedId], references: [id])
  unlocksExams Exam[]  @relation("UnlocksExams")

  @@schema("lazari_lingo")
}

model UserUnlockedExam {
  id String @id @default(nanoid())

  unlockedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@index([userId])
  @@index([examId])
  @@schema("lazari_lingo")
}

model UserExamAggregation {
  id String @id @default(nanoid())

  attemptedCount Int @default(1) // times user attempted the exam
  passedCount    Int @default(0) // times user passed (correctAnswers >= minimumCorrectAnswerCount)
  failedCount    Int @default(0) // times user failed (correctAnswers < minimumCorrectAnswerCount)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())
  lastPassedAt DateTime? // set when a pass counts toward minimumPassedCount

  @@unique([userId, examId])
  @@index([userId])
  @@index([examId])
  @@schema("lazari_lingo")
}

model UserExam {
  id String @id @default(nanoid())

  createdAt DateTime @default(now())

  correctCount Int
  hasPassed    Boolean
  passCounted  Boolean

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([userId, examId])
  @@schema("lazari_lingo")
}

enum ExerciseType {
  CHOOSE_FROM_AUDIO
  INPUT_FROM_AUDIO
  CHOOSE_FROM_TEXT
  INPUT_FROM_TEXT
  INPUT_SENTENCE_FROM_TEXT
  CHOOSE_MATCHING_PATTERNS

  @@schema("lazari_lingo")
}

model Exercise {
  id String @id @default(nanoid())

  type ExerciseType

  prompt String? // anything
  text   String? // word or sentence

  audioUrl     String?
  slowAudioUrl String?

  options                      String[]
  correctOptionIndex           Int[]
  allowsMultipleCorrectOptions Boolean? @default(false)

  correctInputs String[]

  order  Int
  examId String?
  exam   Exam?   @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@schema("lazari_lingo")
}
