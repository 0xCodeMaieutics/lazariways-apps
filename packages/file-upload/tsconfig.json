{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "allowImportingTsExtensions": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@lazariways/shared/*": ["./node_modules/@lazariways/shared/src/*"],
      "@lazariways/file-upload/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "scripts"]
}
